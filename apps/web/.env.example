# Copy this file to .env.local and fill in the values. Do not put secrets in this file.
# In Vercel, add the same four names under Project → Settings → Environment Variables.
# Use the production site URL there instead of localhost.

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API → Project API keys → anon / public
# If the page says "Publishable key", use that.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → Project API keys → service_role / secret
# If the page says "Secret key", use that.
# Stays on the server. Do not add a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# This local site. The Vercel value is the deployment URL, such as https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
